# QuestDB time-series database connection. The URL is a QWP (WebSocket)
# connect string; the client connects lazily, so QuestDB may start late.
# In Docker Compose, use host "questdb". When running locally, use "localhost".
# Keep username/password in sync with the compose QDB_HTTP_USER/QDB_HTTP_PASSWORD.
questdb:
  url: ws::addr=localhost:9000;username=questdb;password=questdb;auto_flush_rows=100;
  running_trades_table: running_trades

# Kafka consumer settings.
# In Docker Compose, use broker host "redpanda" (redpanda:29092).
# When running locally on the host, use "localhost:29092".
kafka:
  brokers: ["redpanda:29092"]
  group: sbterm-ingest
  # Name of the topic for the running trade pipeline. This can be any Kafka
  # topic name; it must match the same setting in config.ws.yaml.
  running_trade_batch_topic: datafeed.running_trade_batch

# Logging settings.
# format supports "text" and "json".
log:
  level: info
  format: text
  add_source: false
