# Stockbit datafeed WebSocket client settings.
# player_id, username, and password are used to obtain and refresh the REST token.
# The client always dials and subscribes to each ws_subscriptions entry at boot;
# leave ws_subscriptions empty to skip the subscription. Each entry opens its
# own connection. Symbol arrays accept explicit symbols (e.g. [BBCA, BBRI]) or
# "*" to subscribe to all symbols on that channel.
stockbit:
  base_url: https://exodus.stockbit.com
  timeout: 30s
  retry_count: 3
  player_id: ""
  username: ""
  password: ""
  ws_url: wss://wss-trading.stockbit.com/ws
  ws_subscriptions:
    - name: running_trade_batch_all
      channels:
        running_trade_batch: ["*"]
    # Dynamic microstructure subscription: symbols are resolved from
    # GET {symbols.base_url}/api/v1/stocks on every (re)connect, and the
    # connection is kicked daily at symbols.refresh_time (WIB) so reconnects
    # pick up the freshest IHSG universe. Supported channels: order_book,
    # liveprice, iepiev, best_bid_offer.
    - name: microstructure_ihsg
      dynamic_channels: [order_book, liveprice, iepiev, best_bid_offer]
  ws_ping_interval: 30s
  ws_reconnect_backoff_initial: 1s
  ws_reconnect_backoff_max: 30s

# Redis connection URL.
# In Docker Compose, use host "redis". When running locally, use "localhost".
redis:
  url: redis://localhost:6379/0

# Kafka producer settings.
# In Docker Compose, use broker host "redpanda" (redpanda:29092).
# When running locally on the host, use "localhost:29092".
kafka:
  brokers: ["redpanda:29092"]
  running_trade_batch_topic: datafeed.running_trade_batch
  order_book_topic: datafeed.order_book
  best_bid_offer_topic: datafeed.best_bid_offer
  iepiev_topic: datafeed.iepiev
  liveprice_topic: datafeed.liveprice

# Dynamic symbol universe (used by subscriptions with dynamic_channels).
# In Docker Compose, use host "api". refresh_time is WIB.
symbols:
  base_url: http://api:8080
  timeout: 10s
  cache_ttl: 10m
  refresh_time: "08:45"

# Logging settings.
# format supports "text" and "json".
log:
  level: info
  format: text
  add_source: false
