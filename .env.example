# Application metadata.
APP_NAME=sbterm-server
APP_VERSION=dev

# HTTP listen address. Use ":8080" to listen on all interfaces inside a container.
APP_PORT=:8080

# PostgreSQL connection URL.
# In Docker Compose, use host "postgres". When running locally, use "localhost".
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sbterm?sslmode=disable

# PostgreSQL connection pool settings.
APP_DB_MAX_CONNS=10
APP_DB_MIN_CONNS=0
APP_DB_MAX_CONN_IDLE_TIME=5m
APP_DB_MAX_CONN_LIFETIME=30m

# Redis connection URL.
# In Docker Compose, use host "redis". When running locally, use "localhost".
APP_REDIS_URL=redis://localhost:6379/0

# Redis retry, pool, and timeout settings.
APP_REDIS_MAX_RETRIES=3
APP_REDIS_POOL_SIZE=10
APP_REDIS_MIN_IDLE_CONNS=0
APP_REDIS_DIAL_TIMEOUT=5s
APP_REDIS_READ_TIMEOUT=3s
APP_REDIS_WRITE_TIMEOUT=3s

# Exodus Stockbit REST API client settings.
APP_STOCKBIT_BASE_URL=https://exodus.stockbit.com
APP_STOCKBIT_TIMEOUT=30s
APP_STOCKBIT_RETRY_COUNT=3

# Logging settings.
# APP_LOG_FORMAT supports "text" and "json".
APP_LOG_LEVEL=info
APP_LOG_FORMAT=text
APP_LOG_ADD_SOURCE=false

# Per-client HTTP rate limit settings.
# Set APP_RATE_LIMIT_RATE <= 0 to disable rate limiting.
APP_RATE_LIMIT_RATE=10
APP_RATE_LIMIT_BURST=20

# HTTP server timeout settings.
APP_HTTP_READ_TIMEOUT=10s
APP_HTTP_WRITE_TIMEOUT=10s
APP_HTTP_IDLE_TIMEOUT=60s
