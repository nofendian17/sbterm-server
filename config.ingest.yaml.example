# QuestDB time-series database connection. The URL is a QWP (WebSocket)
# connect string; the client connects lazily, so QuestDB may start late.
# In Docker Compose, use host "questdb". When running locally, use "localhost".
# Keep username/password in sync with the compose QDB_HTTP_USER/QDB_HTTP_PASSWORD.
questdb:
  url: ws::addr=localhost:9000;username=questdb;password=questdb;auto_flush_rows=100;
  running_trades_table: running_trades
  # Order book snapshots land here as one row per snapshot with 1-D arrays
  # per side (bid_px[1] = best bid). Retention is bounded by TTL days.
  order_book_table: ob_book
  book_ttl_days: 30

# Redis backs the hot-state mirror of the live book (ob:book:<SYM>,
# ob:hash:<SYM>). hot_state.enabled gates the whole bandarmology pipeline:
# when off, microstructure frames are dropped at the handler.
redis:
  url: redis://localhost:6379/0

hot_state:
  enabled: false   # flip to true to run the detector
  prefix: ob
  ttl: 24h
  # Set a topic to publish signals for the stream fan-out (clients subscribe
  # to the "alerts" WS channel). Empty = log-only shadow mode.
  alerts_topic: ""   # e.g. datafeed.alerts

# Kafka consumer settings.
# In Docker Compose, use broker host "redpanda" (redpanda:29092).
# When running locally on the host, use "localhost:29092".
kafka:
  brokers: ["redpanda:29092"]
  group: sbterm-ingest
  # Name of the topic for the running trade pipeline. This can be any Kafka
  # topic name; it must match the same setting in config.ws.yaml.
  running_trade_batch_topic: datafeed.running_trade_batch
  order_book_topic: datafeed.order_book
  best_bid_offer_topic: datafeed.best_bid_offer
  iepiev_topic: datafeed.iepiev
  liveprice_topic: datafeed.liveprice

# Logging settings.
# format supports "text" and "json".
log:
  level: info
  format: text
  add_source: false

# Bandarmology signal evaluator thresholds. Every key is OPTIONAL: omit it to
# keep the engine's built-in default. Only override what you need to tune per
# market. All durations are Go duration strings (e.g. "90s", "5m", "15m").
#
# These drive the four signals:
#   PULL_BID / PULL_ASK — a fat level disappears without executions at its price,
#                          repeatedly inside pull.window.
#   ICEBERG             — a level is consumed by real trades and refilled to near
#                          its reference size, iceberg.n times.
#   ACCUMULATION        — sustained net buying while passive bid support holds
#                          and the mid barely moves.
#   DISTRIBUTION        — the mirror image of accumulation for quiet selling.
detection:
  # Number of best price levels scanned per side by the pull/iceberg rules.
  top_levels: 5
  # How long an execution is kept for the temporal join (proves real demand).
  trade_buffer_ttl: 90s
  # Silence longer than this resets per-symbol detector state (not cooldowns).
  session_gap: 5m
  # Per symbol+signal anti-spam gate: minimum gap between two emissions.
  cooldown: 15m

  pull:
    # Minimum level size (shares) worth treating as a "fat" level.
    min_qty: 500
    # How many unexecuted removals are required inside window before firing.
    repeat_k: 2
    # Lookback window for repeated removals.
    window: 10m

  iceberg:
    # Minimum refill size (shares) that counts as a restoration.
    min_qty: 300
    # Refills required before the signal fires.
    n: 3
    # Refill must match the reference size within this percent (100 - value).
    # 80 means the restored size must land between 80% and 120% of the base.
    uniformity_pct: 80

  # Net-buy configuration for ACCUMULATION.
  accum:
    # Minimum net bought value (price * volume) over the window.
    net_min: 100000000
    # Net-flow window.
    window: 20m
    # Maximum relative mid drift (|mid - baseline| / baseline) while held.
    mid_drift_max: 0.01
    # How long price-support must hold before the signal fires.
    confirm_for: 5m
    # Current bid depth must stay >= gamma * baseline depth (1.0 = no decay).
    support_gamma: 1.0

  # Net-sell configuration for DISTRIBUTION. Mirrors accum; defaults copy
  # accum's values when omitted, so you rarely need to set both.
  distrib:
    net_min: 100000000
    window: 20m
    mid_drift_max: 0.01
    confirm_for: 5m
    support_gamma: 1.0
