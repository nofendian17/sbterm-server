# Application metadata.
app:
  name: sbterm-server
  version: dev

# HTTP listen address. Use ":8080" to listen on all interfaces inside a container.
port: ":8080"

# PostgreSQL connection URL and connection pool settings.
# In Docker Compose, use host "postgres". When running locally, use "localhost".
database:
  url: postgres://postgres:postgres@localhost:5432/sbterm?sslmode=disable
  max_conns: 10
  min_conns: 0
  max_conn_idle_time: 5m
  max_conn_lifetime: 30m

# Redis connection URL and client settings.
# In Docker Compose, use host "redis". When running locally, use "localhost".
redis:
  url: redis://localhost:6379/0
  max_retries: 3
  pool_size: 10
  min_idle_conns: 0
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s

# Exodus Stockbit REST API client settings.
# player_id, username, and password are used to obtain and refresh the token.
stockbit:
  base_url: https://exodus.stockbit.com
  timeout: 30s
  retry_count: 3
  player_id: ""
  username: ""
  password: ""

  # Stockbit datafeed WebSocket client. The client always dials and subscribes
  # to each ws_subscriptions entry at boot; leave ws_subscriptions empty to
  # skip the subscription. Each entry opens its own connection. Symbol arrays
  # accept explicit symbols (e.g. [BBCA, BBRI]) or "*" to subscribe to all
  # symbols on that channel.
  ws_url: wss://wss-trading.stockbit.com/ws
  ws_subscriptions:
    - name: running_trade_batch_all
      channels:
        running_trade_batch: ["*"]
    - name: order_book_v3_selected
      channels:
        order_book_v3: ["BBCA", "BBRI"]
  ws_ping_interval: 30s
  ws_reconnect_backoff_initial: 1s
  ws_reconnect_backoff_max: 30s

# Logging settings.
# format supports "text" and "json".
log:
  level: info
  format: text
  add_source: false

# Per-client HTTP rate limit settings.
# Set rate <= 0 to disable rate limiting.
rate_limit:
  rate: 10
  burst: 20

# HTTP server timeout settings.
http:
  read_timeout: 10s
  write_timeout: 10s
  idle_timeout: 60s
